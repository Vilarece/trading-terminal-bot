# Copy to .env and fill in. Never commit .env itself.

# --- Where this is hosted (required — Blinks need a real public HTTPS URL) ---
# The Actions API and trade page below only work once this is deployed
# somewhere with a real HTTPS domain (Render/Fly.io/Railway free tier, or
# your own). No localhost, no IP address — wallets and Blink clients need a
# stable, secure URL. Set this to that URL once deployed.
PUBLIC_BASE_URL=https://REPLACE_WITH_YOUR_DEPLOYED_URL
PORT=3000

# --- Telegram (required for the bot) ---
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN

# --- Jupiter referral fee ---
# Sept 11, 2026 correction: this CANNOT reuse Idea 1's referral account.
# Each Jupiter API product tab (Referral / Swap+Trigger / Ultra) on
# referral.jup.ag issues a SEPARATE account address for the same wallet —
# create Idea 3's own one there, and its own Referral Token Account for
# every mint in SUPPORTED_TOKENS_JSON below. Using the wrong account fails
# with a "referralAccount is initialized under ... for project ..." error.
# The old FEE_ACCOUNTS_JSON var is gone — the new swap/v2 API derives the
# fee token account automatically from REFERRAL_ACCOUNT + the output mint,
# you no longer pass it explicitly (see server/jupiter.mjs).
# PLATFORM_FEE_BPS: Jupiter's Referral Program enforces a 50bps *minimum*
# as of Sept 2026 (was 20) — default bumped accordingly.
PLATFORM_FEE_BPS=50
REFERRAL_ACCOUNT=REPLACE_WITH_YOUR_OWN_IDEA3_REFERRAL_ACCOUNT_PUBKEY

# Optional: a free API key from https://developers.jup.ag/portal for higher
# rate limits than the unauthenticated default. Leave blank to keep testing.
JUPITER_API_KEY=

# --- v0.2 (Sept 17, 2026) ---
# Your own chat id with the bot (send the bot /whoami). Enables trade alerts,
# /stats, /payouts and the durable referral ledger.
ADMIN_CHAT_ID=
# % of our net fee paid to referrers (30 = 0.12% of referred volume).
REF_SHARE_PCT=30
# SUPPORTED_TOKENS_JSON is no longer used — any token can be traded.
